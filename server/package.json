{
  "name": "athenaeum-library-management-system-server",
  "version": "1.0.0",
  "description": "Backend service for Athenaeum Library Management System",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
  "dev": "nodemon src/server.js",
  "start": "node src/server.js",
  "test": "dotenv -e .env.test -- jest --runInBand --testTimeout=60000",
  "test:ci": "jest --runInBand --ci --testTimeout=60000",
  "test:handles": "dotenv -e .env.test -- jest --runInBand --detectOpenHandles --testTimeout=60000",
  "lint": "eslint src tests"
},
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.0",
    "razorpay": "^2.9.4",
    "sequelize": "^6.37.3",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@scarf/scarf@1.4.0": true,
    "msgpackr-extract@3.0.4": true
  }
}
